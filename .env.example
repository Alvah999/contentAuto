# Server
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
SAMPLES_DIR=./samples

# Dashboard (Vite)
VITE_API_URL=http://localhost:3001

# OpenAI — leave empty to use deterministic mock AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Figma REST (optional; plugin works without these)
FIGMA_ACCESS_TOKEN=
FIGMA_TEAM_ID=

# Google Docs/Sheets (optional; Phase 1 uses local JSON samples)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
GOOGLE_DOCS_ID=
